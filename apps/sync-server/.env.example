# Sonagi Draw sync-server 환경변수 (예시)
# 실제 값은 .env 에 두고, .env 는 절대 저장소에 커밋하지 않는다.

# MinIO / S3 (에셋 저장)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# API 인증 게이트
# - 설정하면 외부(Cloudflare 경유) 요청은 /api/auth 로그인 후에만 /api/* 접근 가능
# - 로컬(127.0.0.1, Cloudflare 헤더 없음)은 인증 없이 허용 (MCP/Playwright)
DRAW_APP_PASSWORD=
DRAW_SESSION_SECRET=
