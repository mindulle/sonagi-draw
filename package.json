{
  "name": "sonagi-draw-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "docker-compose up -d && pnpm -r dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
